<%- include('partials/head') %>
<%- include('partials/header') %>

<div class="bg-gray-100 dark:bg-gray-900 min-h-screen py-12 transition-colors duration-300">
    <div class="container mx-auto px-4">
        <header class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between">
            <div>
                <h1 class="text-3xl font-bold text-gray-800 dark:text-white">Bonjour, <%= user.email %></h1>
                <p class="text-gray-600 dark:text-gray-400">Bienvenue sur votre tableau de bord Cutflow.</p>
            </div>
            <% if (locals.success) { %>
                <script>
                    window.addEventListener('DOMContentLoaded', () => {
                        modal.show({
                            title: 'Succès',
                            message: '<%= success %>',
                            type: 'success'
                        });
                    });
                </script>
            <% } %>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <!-- Téléchargement -->
            <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-md border-2 border-gray-200 dark:border-gray-700 hover:border-blue-400 dark:hover:border-blue-500 transition-all">
                <div class="flex items-center mb-4">
                    <div class="p-3 bg-blue-100 dark:bg-blue-900 text-blue-600 dark:text-blue-300 rounded-lg mr-4 border-2 border-blue-200 dark:border-blue-700">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                    </div>
                    <h2 class="text-xl font-bold text-gray-800 dark:text-white">Téléchargement</h2>
                </div>
                <p class="text-gray-600 dark:text-gray-400 mb-6">Obtenez la dernière version de Cutflow pour votre système.</p>
                <div class="space-y-3">
                    <button class="w-full bg-blue-600 text-white py-2 rounded-lg font-semibold hover:bg-blue-700 transition border-2 border-blue-700 shadow-md">Télécharger pour Windows</button>
                    <button class="w-full border-2 border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 py-2 rounded-lg font-semibold hover:bg-gray-50 dark:hover:bg-gray-700 transition">MacOS (M1/M2/Intel)</button>
                </div>
            </div>

            <!-- Licence et Abonnement -->
            <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-md border-2 border-gray-200 dark:border-gray-700 hover:border-green-400 dark:hover:border-green-500 transition-all">
                <div class="flex items-center mb-4">
                    <div class="p-3 <%= user.license_status === 'Actif' ? 'bg-green-100 dark:bg-green-900 text-green-600 dark:text-green-300 border-green-200 dark:border-green-700' : 'bg-red-100 dark:bg-red-900 text-red-600 dark:text-red-300 border-red-200 dark:border-red-700' %> border-2 rounded-lg mr-4">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                    </div>
                    <h2 class="text-xl font-bold text-gray-800 dark:text-white">Ma Licence</h2>
                </div>
                <div class="space-y-4 mb-6">
                    <div class="flex justify-between items-center">
                        <span class="text-gray-600 dark:text-gray-400">Type :</span>
                        <span class="font-bold text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/30 px-3 py-1 rounded-full text-sm border border-blue-200 dark:border-blue-700"><%= user.license_type %></span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-gray-600 dark:text-gray-400">Statut :</span>
                        <span class="<%= user.license_status === 'Actif' ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400' %> font-semibold"><%= user.license_status %></span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-gray-600 dark:text-gray-400">Prochain prélèvement :</span>
                        <span class="font-medium dark:text-gray-300"><%= user.next_billing_date || 'N/A' %></span>
                    </div>
                </div>
                <a href="/tarifs" class="block w-full text-center bg-gray-800 dark:bg-gray-700 text-white py-2 rounded-lg font-semibold hover:bg-gray-900 dark:hover:bg-gray-600 transition border-2 border-gray-900 dark:border-gray-600 shadow-md">
                    <%= user.license_status === 'Actif' ? 'Upgrade vers Pro' : 'S\'abonner' %>
                </a>
                <% if (user.license_status === 'Actif' && user.license_type !== 'Gratuit') { %>
                    <button onclick="confirmCancelSubscription()" class="w-full mt-3 text-sm text-red-500 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300 font-medium transition-colors">
                        Annuler mon abonnement
                    </button>
                    <form id="cancel-sub-form" action="/annuler-abonnement" method="POST" class="hidden"></form>
                <% } %>
            </div>

            <!-- Documentation -->
            <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-md border-2 border-gray-200 dark:border-gray-700 hover:border-purple-400 dark:hover:border-purple-500 transition-all">
                <div class="flex items-center mb-4">
                    <div class="p-3 bg-purple-100 dark:bg-purple-900 text-purple-600 dark:text-purple-300 rounded-lg mr-4 border-2 border-purple-200 dark:border-purple-700">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                    </div>
                    <h2 class="text-xl font-bold text-gray-800 dark:text-white">Documentation</h2>
                </div>
                <p class="text-gray-600 dark:text-gray-400 mb-6">Apprenez à maîtriser Cutflow avec nos guides complets et tutoriels vidéo.</p>
                <ul class="space-y-2 mb-6 text-blue-600 dark:text-blue-400 font-medium">
                    <li><a href="#" class="hover:underline flex items-center"><svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"></path></svg> Guide de démarrage rapide</a></li>
                    <li><a href="#" class="hover:underline flex items-center"><svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"></path></svg> Raccourcis clavier</a></li>
                    <li><a href="#" class="hover:underline flex items-center"><svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"></path></svg> Exportation 4K</a></li>
                </ul>
                <button class="w-full border-2 border-purple-200 dark:border-purple-800 text-purple-600 dark:text-purple-400 py-2 rounded-lg font-semibold hover:bg-purple-50 dark:hover:bg-purple-900/30 transition shadow-sm">Accéder au centre d'aide</button>
            </div>

            <!-- Bibliothèque de Plugins -->
            <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-md border-2 border-gray-200 dark:border-gray-700 hover:border-indigo-400 dark:hover:border-indigo-500 transition-all lg:col-span-1">
                <div class="flex items-center mb-4">
                    <div class="p-3 bg-indigo-100 dark:bg-indigo-900 text-indigo-600 dark:text-indigo-300 rounded-lg mr-4 border-2 border-indigo-200 dark:border-indigo-700">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 00-1 1v1a2 2 0 11-4 0v-1a1 1 0 00-1-1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"></path></svg>
                    </div>
                    <h2 class="text-xl font-bold text-gray-800 dark:text-white">Plugins</h2>
                </div>
                <div class="space-y-4">
                    <div class="p-4 bg-indigo-50 dark:bg-indigo-900/30 rounded-lg border-2 border-indigo-100 dark:border-indigo-800">
                        <div class="flex justify-between items-start mb-2">
                            <h3 class="font-bold text-indigo-900 dark:text-indigo-300">Video Finder IA</h3>
                            <span class="bg-indigo-600 text-white text-[10px] px-2 py-0.5 rounded-full uppercase border border-indigo-400">Populaire</span>
                        </div>
                        <p class="text-xs text-indigo-700 dark:text-indigo-400 mb-3">Retrouvez n'importe quelle vidéo à partir d'un simple extrait grâce à la recherche web par IA.</p>
                        <a href="/plugins" class="block w-full text-center bg-indigo-600 text-white py-2 rounded-lg text-sm font-semibold hover:bg-indigo-700 transition border-2 border-indigo-700 shadow-md">Ouvrir le plugin</a>
                    </div>
                    <a href="/plugins" class="block w-full text-center border-2 border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 py-2 rounded-lg text-sm font-semibold hover:bg-gray-50 dark:hover:bg-gray-700 transition">Parcourir la bibliothèque</a>
                </div>
            </div>

            <!-- Mises à jour -->
            <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-md border-2 border-gray-200 dark:border-gray-700 hover:border-yellow-400 dark:hover:border-yellow-500 transition-all lg:col-span-1">
                <div class="flex items-center mb-4">
                    <div class="p-3 bg-yellow-100 dark:bg-yellow-900 text-yellow-600 dark:text-yellow-300 rounded-lg mr-4 border-2 border-yellow-200 dark:border-yellow-700">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                    </div>
                    <h2 class="text-xl font-bold text-gray-800 dark:text-white">Mises à Jour</h2>
                </div>
                <div class="space-y-4">
                    <div class="border-l-4 border-yellow-400 pl-4 py-2 bg-yellow-50/30 dark:bg-yellow-900/10 rounded-r-lg">
                        <h3 class="font-bold text-gray-800 dark:text-white text-sm">Version 1.1.0</h3>
                        <p class="text-[10px] text-gray-500 dark:text-gray-400 mb-1">5 janv. 2026</p>
                        <p class="text-xs text-gray-600 dark:text-gray-300">Lancement de la bibliothèque de plugins !</p>
                    </div>
                    <div class="border-l-4 border-gray-200 dark:border-gray-700 pl-4 py-2">
                        <h3 class="font-bold text-gray-400 dark:text-gray-500 text-sm">Version 1.0.0</h3>
                        <p class="text-[10px] text-gray-400 dark:text-gray-600 mb-1">1 janv. 2026</p>
                    </div>
                </div>
            </div>

            <!-- Utilisation de la licence -->
            <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-md border-2 border-gray-200 dark:border-gray-700 hover:border-red-400 dark:hover:border-red-500 transition-all">
                <div class="flex items-center mb-4">
                    <div class="p-3 bg-red-100 dark:bg-red-900 text-red-600 dark:text-red-300 rounded-lg mr-4 border-2 border-red-200 dark:border-red-700">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
                    </div>
                    <h2 class="text-xl font-bold text-gray-800 dark:text-white">Utilisation</h2>
                </div>
                <div class="space-y-4">
                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span class="text-gray-600 dark:text-gray-400">Postes activés</span>
                            <span class="font-bold dark:text-white"><%= user.license_status === 'Actif' ? '1' : '0' %> / <%= user.license_type === 'Studio' ? '5' : (user.license_type === 'Pro' ? '2' : (user.license_type === 'Gratuit' ? '1' : '0')) %></span>
                        </div>
                        <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-3 border border-gray-300 dark:border-gray-600">
                            <div class="bg-blue-600 h-2.5 rounded-full" style="width: <%= user.license_status === 'Inactif' ? '0%' : (user.license_type === 'Studio' ? '20%' : (user.license_type === 'Pro' ? '50%' : '100%')) %>"></div>
                        </div>
                    </div>
                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span class="text-gray-600 dark:text-gray-400">Cloud Storage (Go)</span>
                            <span class="font-bold dark:text-white"><%= user.license_status === 'Actif' ? '5' : '0' %> / <%= user.license_type === 'Studio' ? '100' : (user.license_type === 'Pro' ? '20' : (user.license_type === 'Gratuit' ? '2' : '0')) %></span>
                        </div>
                        <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-3 border border-gray-300 dark:border-gray-600">
                            <div class="bg-purple-600 h-2.5 rounded-full" style="width: <%= user.license_status === 'Inactif' ? '0%' : (user.license_type === 'Studio' ? '5%' : (user.license_type === 'Pro' ? '25%' : '100%')) %>"></div>
                        </div>
                    </div>
                </div>
                <p class="text-xs text-gray-400 dark:text-gray-500 mt-6 italic">* Les limites dépendent de votre type d'abonnement.</p>
            </div>

            <!-- Derniers échanges Service Client -->
            <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-md border-2 border-gray-200 dark:border-gray-700 hover:border-green-400 dark:hover:border-green-500 transition-all md:col-span-2 lg:col-span-3">
                <div class="flex items-center mb-4">
                    <div class="p-3 bg-green-100 dark:bg-green-900 text-green-600 dark:text-green-300 rounded-lg mr-4 border-2 border-green-200 dark:border-green-700">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
                    </div>
                    <h2 class="text-xl font-bold text-gray-800 dark:text-white">Derniers échanges</h2>
                </div>
                
                <% if (contacts && contacts.length > 0) { %>
                    <div class="space-y-4">
                        <% contacts.forEach(contact => { %>
                            <div class="p-4 bg-gray-50 dark:bg-gray-700/50 rounded-lg border-2 border-gray-100 dark:border-gray-600">
                                <div class="flex justify-between items-start mb-2">
                                    <h3 class="font-bold text-gray-800 dark:text-white"><%= contact.subject %></h3>
                                    <span class="text-xs text-gray-500 dark:text-gray-400"><%= new Date(contact.created_at).toLocaleDateString('fr-FR') %></span>
                                </div>
                                <p class="text-sm text-gray-600 dark:text-gray-300 line-clamp-2 italic">"<%= contact.message %>"</p>
                                <div class="mt-3 flex items-center text-xs text-blue-600 dark:text-blue-400 font-semibold">
                                    <span class="w-2 h-2 bg-blue-600 rounded-full mr-2"></span>
                                    En attente de réponse
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="text-center py-8">
                        <p class="text-gray-500 dark:text-gray-400 mb-4">Vous n'avez pas encore d'échanges avec notre support.</p>
                        <a href="/contact" class="text-blue-600 dark:text-blue-400 font-bold hover:underline">Envoyer un message</a>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Zone de Danger -->
        <div class="mt-12 p-8 bg-red-50 dark:bg-red-900/10 rounded-2xl border-2 border-red-200 dark:border-red-900/50">
            <h2 class="text-2xl font-bold text-red-800 dark:text-red-400 mb-4">Zone de danger</h2>
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
                <div>
                    <h3 class="font-bold text-gray-800 dark:text-white">Supprimer mon compte</h3>
                    <p class="text-gray-600 dark:text-gray-400 text-sm">Une fois votre compte supprimé, il n'y a pas de retour en arrière. Toutes vos données seront effacées.</p>
                </div>
                <button onclick="confirmDeleteAccount()" class="px-6 py-3 bg-red-600 text-white font-bold rounded-xl hover:bg-red-700 transition border-2 border-red-700 shadow-md whitespace-nowrap">
                    Supprimer mon compte
                </button>
            </div>
            <form id="delete-account-form" action="/supprimer-compte" method="POST" class="hidden"></form>
        </div>
    </div>
</div>

<script>
    // Confirmation avant l'annulation de l'abonnement
    function confirmCancelSubscription() {
        modal.show({
            title: 'Annuler l\'abonnement ?',
            message: 'Êtes-vous sûr de vouloir annuler votre abonnement ? Vous perdrez l\'accès aux fonctionnalités Premium à la fin de la période en cours.',
            type: 'warning',
            showCancel: true,
            confirmText: 'Oui, annuler',
            onConfirm: () => {
                document.getElementById('cancel-sub-form').submit();
            }
        });
    }

    // Confirmation avant la suppression définitive du compte
    function confirmDeleteAccount() {
        modal.show({
            title: 'Supprimer définitivement ?',
            message: 'Cette action est irréversible. Toutes vos données, licences et accès seront définitivement supprimés.',
            type: 'error',
            showCancel: true,
            confirmText: 'Supprimer mon compte',
            onConfirm: () => {
                document.getElementById('delete-account-form').submit();
            }
        });
    }
</script>

<%- include('partials/footer') %>