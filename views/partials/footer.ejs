<!-- Bandeau Cookies -->
<div id="cookie-banner" class="fixed bottom-0 left-0 right-0 bg-gray-900 dark:bg-black text-white p-4 transform translate-y-full transition-transform duration-300 z-50 border-t-2 border-gray-700 dark:border-blue-900">
    <div class="container mx-auto flex flex-col md:flex-row justify-between items-center">
        <p class="text-sm mb-4 md:mb-0">Nous utilisons des cookies pour améliorer votre expérience sur notre site. <a href="/legal/cookies" class="underline hover:text-blue-400">En savoir plus</a>.</p>
        <div class="flex space-x-4">
            <button onclick="acceptCookies()" class="bg-blue-600 px-4 py-2 rounded text-sm font-bold border-2 border-blue-500 hover:bg-blue-700 transition-colors">Accepter</button>
            <button onclick="refuseCookies()" class="bg-gray-700 px-4 py-2 rounded text-sm font-bold border-2 border-gray-600 hover:bg-gray-600 transition-colors">Refuser</button>
        </div>
    </div>
</div>

<script>
    // Gestion du consentement des cookies
    function acceptCookies() {
        document.getElementById('cookie-banner').style.transform = 'translateY(100%)';
        localStorage.setItem('cookiesAccepted', 'true');
    }
    function refuseCookies() {
        document.getElementById('cookie-banner').style.transform = 'translateY(100%)';
        localStorage.setItem('cookiesAccepted', 'false');
    }
    window.onload = function() {
        // Affichage du bandeau après 1 seconde si aucun choix n'a été fait précédemment
        if (!localStorage.getItem('cookiesAccepted')) {
            setTimeout(() => {
                document.getElementById('cookie-banner').style.transform = 'translateY(0)';
            }, 1000);
        }
    }
</script>

