<!-- Structure de la modale personnalisée -->
<div id="custom-modal" class="fixed inset-0 z-[100] flex items-center justify-center hidden">
    <!-- Fond semi-transparent (Overlay) -->
    <div id="modal-overlay" class="absolute inset-0 bg-black bg-opacity-50 backdrop-blur-sm transition-opacity"></div>
    
    <!-- Contenu principal de la modale -->
    <div id="modal-container" class="relative bg-white dark:bg-gray-800 rounded-2xl shadow-2xl max-w-sm w-full mx-4 overflow-hidden transform transition-all scale-95 opacity-0 border-2 border-gray-100 dark:border-gray-700">
        <div class="p-5">
            <div class="flex items-center justify-center mb-4" id="modal-icon-container">
                <!-- L'icône sera injectée dynamiquement selon le type -->
            </div>
            
            <h3 id="modal-title" class="text-xl font-bold text-center text-gray-800 dark:text-white mb-2"></h3>
            <p id="modal-message" class="text-gray-600 dark:text-gray-400 text-center mb-6 text-sm"></p>
            
            <div class="flex flex-col space-y-2">
                <button id="modal-confirm-btn" class="w-full py-2.5 rounded-xl font-bold transition-colors border-2 text-sm">
                    OK
                </button>
                <button id="modal-cancel-btn" class="w-full py-2.5 rounded-xl font-bold text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors hidden border-2 border-transparent text-sm">
                    Annuler
                </button>
            </div>
        </div>
        
        <!-- Barre de progression (pour fermeture automatique) -->
        <div id="modal-progress" class="absolute bottom-0 left-0 h-1 bg-blue-600 transition-all duration-[3000ms] ease-linear w-0"></div>
    </div>
</div>

<script>
    // Objet global pour gérer les modales
    const modal = {
        el: document.getElementById('custom-modal'),
        container: document.getElementById('modal-container'),
        title: document.getElementById('modal-title'),
        message: document.getElementById('modal-message'),
        iconContainer: document.getElementById('modal-icon-container'),
        confirmBtn: document.getElementById('modal-confirm-btn'),
        cancelBtn: document.getElementById('modal-cancel-btn'),
        progress: document.getElementById('modal-progress'),
        
        // Templates d'icônes SVG par type
        icons: {
            success: `<div class="w-12 h-12 bg-green-100 dark:bg-green-900/50 text-green-600 dark:text-green-400 rounded-full flex items-center justify-center text-2xl border-2 border-green-200 dark:border-green-800">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                      </div>`,
            error: `<div class="w-12 h-12 bg-red-100 dark:bg-red-900/50 text-red-600 dark:text-red-400 rounded-full flex items-center justify-center text-2xl border-2 border-red-200 dark:border-red-800">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                      </div>`,
            info: `<div class="w-12 h-12 bg-blue-100 dark:bg-blue-900/50 text-blue-600 dark:text-blue-400 rounded-full flex items-center justify-center text-2xl border-2 border-blue-200 dark:border-blue-800">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                      </div>`,
            warning: `<div class="w-12 h-12 bg-yellow-100 dark:bg-yellow-900/50 text-yellow-600 dark:text-yellow-400 rounded-full flex items-center justify-center text-2xl border-2 border-yellow-200 dark:border-yellow-800">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                      </div>`
        },

        show(options = {}) {
            const { 
                title = 'Information', 
                message = '', 
                type = 'info', 
                confirmText = 'OK', 
                cancelText = 'Annuler',
                showCancel = false,
                onConfirm = null,
                autoClose = false
            } = options;

            this.title.innerText = title;
            this.message.innerText = message;
            this.iconContainer.innerHTML = this.icons[type] || this.icons.info;
            this.confirmBtn.innerText = confirmText;
            this.cancelBtn.innerText = cancelText;
            
            // Personnalisation du bouton selon le type d'alerte
            this.confirmBtn.className = 'w-full py-2.5 rounded-xl font-bold transition-colors text-white border-2 text-sm';
            if (type === 'success') this.confirmBtn.classList.add('bg-green-600', 'hover:bg-green-700', 'border-green-700');
            else if (type === 'error') this.confirmBtn.classList.add('bg-red-600', 'hover:bg-red-700', 'border-red-700');
            else if (type === 'warning') this.confirmBtn.classList.add('bg-yellow-500', 'hover:bg-yellow-600', 'border-yellow-600');
            else this.confirmBtn.classList.add('bg-blue-600', 'hover:bg-blue-700', 'border-blue-700');

            if (showCancel) this.cancelBtn.classList.remove('hidden');
            else this.cancelBtn.classList.add('hidden');

            this.el.classList.remove('hidden');
            
            // Animation d'ouverture
            setTimeout(() => {
                this.container.classList.remove('scale-95', 'opacity-0');
                this.container.classList.add('scale-100', 'opacity-100');
            }, 10);

            this.confirmBtn.onclick = () => {
                this.hide();
                if (onConfirm) onConfirm();
            };

            this.cancelBtn.onclick = () => this.hide();
            
            if (autoClose) {
                this.progress.style.width = '100%';
                setTimeout(() => this.hide(), 3000);
            } else {
                this.progress.style.width = '0';
            }
        },

        hide() {
            this.container.classList.remove('scale-100', 'opacity-100');
            this.container.classList.add('scale-95', 'opacity-0');
            setTimeout(() => {
                this.el.classList.add('hidden');
                this.progress.style.width = '0';
            }, 300);
        }
    };

    // Redéfinition de l'alerte native du navigateur
    window.alert = function(message) {
        modal.show({
            title: 'Attention',
            message: message,
            type: 'info'
        });
    };
</script>