                        <div class="flex space-x-1">
                            <div class="w-2 h-2 rounded-full bg-red-500"></div>
                            <div class="w-2 h-2 rounded-full bg-yellow-500"></div>
                            <div class="w-2 h-2 rounded-full bg-green-500"></div>
                        </div>
                        <div class="text-[10px] text-gray-500 font-mono flex items-center">
                            <img src="/images/logo.jpg" alt="Logo" class="h-3 w-3 mr-1 rounded-sm">
                            Cutflow Pro - Projet_Sans_Titre.cfp
                        </div>
                    </div>
