                                    <div class="bg-green-900/50 border border-green-700 w-32 rounded-sm"></div>
                                    <div class="bg-green-900/50 border border-green-700 w-16 rounded-sm"></div>
                                    <div class="bg-green-900/50 border border-green-700 w-40 rounded-sm"></div>
                                </div>
                            </div>
                        </div>
