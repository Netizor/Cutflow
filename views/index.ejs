                    Voir la démo
                </a>
            </div>
            <% if (locals.success) { %>
                <script>
                    window.addEventListener('DOMContentLoaded', () => {
                        modal.show({
                            title: 'Compte supprimé',
                            message: '<%= success %>',
                            type: 'success'
                        });
                    });
                </script>
            <% } %>
        </div>
        <div class="md:w-1/2">
            <div class="bg-gray-200 dark:bg-gray-700 rounded-lg shadow-2xl p-2 transform rotate-2 border-2 border-gray-300 dark:border-gray-600">
