                                <img src="/images/logo.jpg" alt="Logo" class="w-full h-full object-cover">
                            </div>
                            <div class="w-6 h-6 bg-blue-600 rounded-md"></div>
                            <div class="w-6 h-6 bg-gray-700 rounded-md"></div>
                            <div class="w-6 h-6 bg-gray-700 rounded-md"></div>
                        </div>
                        <!-- Viewport -->
                        <div class="flex-grow flex flex-col bg-gray-950">
                            <div class="flex-grow relative flex items-center justify-center p-4">
                                <div class="w-full h-full bg-gray-900 rounded border border-gray-800 flex items-center justify-center relative overflow-hidden">
                                    <div class="w-16 h-16 bg-blue-600/20 rounded-full flex items-center justify-center border-2 border-blue-500/50 overflow-hidden">
