<%- include('partials/head') %>
<%- include('partials/header') %>

<!-- Section d'en-tête (Hero) -->
<section class="bg-gradient-to-r from-blue-600 to-blue-800 dark:from-blue-800 dark:to-blue-950 text-white py-20 border-b-4 border-blue-700 dark:border-blue-900">
    <div class="container mx-auto px-4 flex flex-col md:flex-row items-center">
        <div class="md:w-1/2 mb-10 md:mb-0">
            <h1 class="text-4xl md:text-6xl font-bold mb-6 text-center md:text-left">Réalisez vos montages vidéo en un clin d'œil.</h1>
            <p class="text-xl mb-8 text-blue-100 text-center md:text-left">Cutflow simplifie le processus de création vidéo grâce à une interface intuitive et des outils puissants pilotés par l'IA.</p>
            <div class="flex flex-col sm:flex-row justify-center md:justify-start space-y-4 sm:space-y-0 sm:space-x-4">
                <a href="/connexion" class="bg-white text-blue-600 px-8 py-3 rounded-full font-bold hover:bg-blue-50 transition text-center border-2 border-transparent hover:border-blue-600">Essai Gratuit</a>
                <a href="#demo" class="border-2 border-white text-white px-8 py-3 rounded-full font-bold hover:bg-white hover:text-blue-600 transition flex items-center justify-center">
                    <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z"></path></svg>
                    Voir la démo
                </a>
            </div>
            <% if (locals.success) { %>
                <script>
                    window.addEventListener('DOMContentLoaded', () => {
                        modal.show({
                            title: 'Compte supprimé',
                            message: '<%= success %>',
                            type: 'success'
                        });
                    });
                </script>
            <% } %>
        </div>
        <div class="md:w-1/2">
            <div class="bg-gray-200 dark:bg-gray-700 rounded-lg shadow-2xl p-4 transform rotate-2 border-2 border-gray-300 dark:border-gray-600">
                <div class="bg-gray-800 rounded h-64 md:h-96 flex items-center justify-center border-2 border-gray-900">
                    <p class="text-gray-500">[Mockup Interface Logiciel]</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Vidéo Promotionnelle -->
<section id="demo" class="py-20 bg-white dark:bg-gray-900 transition-colors duration-300">
    <div class="container mx-auto px-4 text-center">
        <h2 class="text-3xl font-bold mb-12 dark:text-white">Découvrez Cutflow en 30 secondes</h2>
        <div class="max-w-4xl mx-auto aspect-video bg-black rounded-xl flex items-center justify-center text-white border-4 border-gray-200 dark:border-gray-700 shadow-xl">
            <p>[Vidéo Promotionnelle - 30s]</p>
        </div>
    </div>
</section>

<!-- Pourquoi ce logiciel ? -->
<section class="py-20 bg-gray-50 dark:bg-gray-800 transition-colors duration-300">
    <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-16 dark:text-white">Pourquoi choisir Cutflow ?</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="bg-white dark:bg-gray-700 p-8 rounded-xl shadow-md border-2 border-gray-100 dark:border-gray-600 text-center hover:border-blue-400 dark:hover:border-blue-500 transition-all">
                <div class="w-16 h-16 bg-blue-100 dark:bg-blue-900 text-blue-600 dark:text-blue-300 rounded-full flex items-center justify-center mx-auto mb-6 text-2xl border-2 border-blue-200 dark:border-blue-700">⚡</div>
                <h3 class="text-xl font-bold mb-4 dark:text-white">Gain de temps</h3>
                <p class="text-gray-600 dark:text-gray-300">Automatisez les tâches répétitives et concentrez-vous sur votre créativité.</p>
            </div>
            <div class="bg-white dark:bg-gray-700 p-8 rounded-xl shadow-md border-2 border-gray-100 dark:border-gray-600 text-center hover:border-green-400 dark:hover:border-green-500 transition-all">
                <div class="w-16 h-16 bg-green-100 dark:bg-green-900 text-green-600 dark:text-green-300 rounded-full flex items-center justify-center mx-auto mb-6 text-2xl border-2 border-green-200 dark:border-green-700">✨</div>
                <h3 class="text-xl font-bold mb-4 dark:text-white">Simplicité</h3>
                <p class="text-gray-600 dark:text-gray-300">Une interface drag-and-drop accessible à tous, sans formation complexe.</p>
            </div>
            <div class="bg-white dark:bg-gray-700 p-8 rounded-xl shadow-md border-2 border-gray-100 dark:border-gray-600 text-center hover:border-purple-400 dark:hover:border-purple-500 transition-all">
                <div class="w-16 h-16 bg-purple-100 dark:bg-purple-900 text-purple-600 dark:text-purple-300 rounded-full flex items-center justify-center mx-auto mb-6 text-2xl border-2 border-purple-200 dark:border-purple-700">🚀</div>
                <h3 class="text-xl font-bold mb-4 dark:text-white">Performances</h3>
                <p class="text-gray-600 dark:text-gray-300">Rendu ultra-rapide et exportations optimisées pour tous les réseaux sociaux.</p>
            </div>
        </div>
    </div>
</section>

<!-- Section Avant / Après -->
<section class="py-20 bg-white dark:bg-gray-900 transition-colors duration-300">
    <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-16 dark:text-white">Avant vs Après Cutflow</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
            <div class="bg-red-50 dark:bg-red-950/30 p-6 md:p-8 rounded-xl border-2 border-red-100 dark:border-red-900/50">
                <h3 class="text-xl font-bold text-red-600 dark:text-red-400 mb-4">Montage Classique</h3>
                <ul class="space-y-4">
                    <li class="flex items-start dark:text-gray-300"><span class="text-red-500 mr-2">❌</span> Interface complexe et surchargée</li>
                    <li class="flex items-start dark:text-gray-300"><span class="text-red-500 mr-2">❌</span> Heures perdues en tâches manuelles</li>
                    <li class="flex items-start dark:text-gray-300"><span class="text-red-500 mr-2">❌</span> Rendus lents et bogues fréquents</li>
                </ul>
            </div>
            <div class="bg-green-50 dark:bg-green-950/30 p-6 md:p-8 rounded-xl border-2 border-green-100 dark:border-green-900/50">
                <h3 class="text-xl font-bold text-green-600 dark:text-green-400 mb-4">Avec Cutflow</h3>
                <ul class="space-y-4">
                    <li class="flex items-start dark:text-gray-300"><span class="text-green-500 mr-2">✅</span> Workflow fluide et intuitif</li>
                    <li class="flex items-start dark:text-gray-300"><span class="text-green-500 mr-2">✅</span> IA qui assiste votre montage</li>
                    <li class="flex items-start dark:text-gray-300"><span class="text-green-500 mr-2">✅</span> Rendu instantané 4K</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- Section FAQ simplifiée -->
<section class="py-20 bg-gray-50 dark:bg-gray-800 transition-colors duration-300">
    <div class="container mx-auto px-4 text-center">
        <h2 class="text-3xl font-bold mb-8 dark:text-white">Des questions ?</h2>
        <p class="text-xl text-gray-600 dark:text-gray-400 mb-10">Consultez notre foire aux questions complète pour trouver toutes les réponses à vos interrogations.</p>
        <a href="/faq" class="inline-block bg-white dark:bg-gray-700 text-blue-600 dark:text-blue-400 px-10 py-4 rounded-full font-bold hover:bg-blue-50 dark:hover:bg-gray-600 transition border-2 border-blue-600 dark:border-blue-500 shadow-md">Voir la FAQ complète</a>
    </div>
</section>

<%- include('partials/footer') %>
