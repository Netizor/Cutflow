<%- include('partials/head') %>
<%- include('partials/header') %>

<section class="py-20 bg-white dark:bg-gray-900 transition-colors duration-300">
    <div class="container mx-auto px-4 max-w-4xl">
        <h1 class="text-4xl font-bold mb-6 dark:text-white">Présentation du Projet Cutflow</h1>
        <p class="text-xl text-gray-600 dark:text-gray-400 mb-10">Une analyse approfondie de notre solution de montage vidéo innovante.</p>
        
        <div class="aspect-video bg-gray-950 rounded-2xl mb-12 flex flex-col items-center justify-center text-white border-4 border-gray-200 dark:border-gray-700 shadow-2xl relative group overflow-hidden">
            <div class="absolute inset-0 bg-blue-600/10 group-hover:bg-blue-600/20 transition-colors"></div>
            <div class="w-20 h-20 bg-blue-600 rounded-full flex items-center justify-center border-4 border-white/30 shadow-2xl transform group-hover:scale-110 transition-transform cursor-pointer">
                <svg class="w-10 h-10 ml-1" fill="currentColor" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z"></path></svg>
            </div>
            <p class="mt-4 font-bold text-lg tracking-wider">REGARDER LA PRÉSENTATION (10:00)</p>
            <div class="absolute bottom-4 left-4 right-4 h-1 bg-gray-800 rounded-full overflow-hidden">
                <div class="h-full bg-blue-600 w-0 group-hover:w-full transition-all duration-[600s] ease-linear"></div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
            <div class="p-6 bg-blue-50 dark:bg-blue-900/30 rounded-xl border-2 border-blue-100 dark:border-blue-800">
                <h3 class="font-bold mb-2 dark:text-blue-300 text-blue-800">Contexte</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400">Développement d'un outil pour démocratiser le montage vidéo professionnel.</p>
            </div>
            <div class="p-6 bg-green-50 dark:bg-green-900/30 rounded-xl border-2 border-green-100 dark:border-green-800">
                <h3 class="font-bold mb-2 dark:text-green-300 text-green-800">Marché</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400">Cible : YouTubeurs, créateurs TikTok, et petites entreprises.</p>
            </div>
            <div class="p-6 bg-purple-50 dark:bg-purple-900/30 rounded-xl border-2 border-purple-100 dark:border-purple-800">
                <h3 class="font-bold mb-2 dark:text-purple-300 text-purple-800">Objectif</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400">Réduire le temps de montage de 60% grâce à l'automatisation intelligente.</p>
            </div>
        </div>

        <h2 class="text-2xl font-bold mb-6 dark:text-white">Sommaire de la présentation</h2>
        <ol class="space-y-4 mb-12">
            <li class="flex items-center p-4 bg-gray-50 dark:bg-gray-800 rounded-lg border-2 border-gray-100 dark:border-gray-700 dark:text-gray-300 shadow-sm hover:border-blue-400 transition-all"><span class="w-8 h-8 bg-blue-600 text-white rounded-full flex items-center justify-center mr-4 border-2 border-blue-400">1</span> Introduction et problématique (0:00 - 2:00)</li>
            <li class="flex items-center p-4 bg-gray-50 dark:bg-gray-800 rounded-lg border-2 border-gray-100 dark:border-gray-700 dark:text-gray-300 shadow-sm hover:border-blue-400 transition-all"><span class="w-8 h-8 bg-blue-600 text-white rounded-full flex items-center justify-center mr-4 border-2 border-blue-400">2</span> Analyse du marché et de la concurrence (2:00 - 4:00)</li>
            <li class="flex items-center p-4 bg-gray-50 dark:bg-gray-800 rounded-lg border-2 border-gray-100 dark:border-gray-700 dark:text-gray-300 shadow-sm hover:border-blue-400 transition-all"><span class="w-8 h-8 bg-blue-600 text-white rounded-full flex items-center justify-center mr-4 border-2 border-blue-400">3</span> Démonstration des fonctionnalités clés (4:00 - 8:00)</li>
            <li class="flex items-center p-4 bg-gray-50 dark:bg-gray-800 rounded-lg border-2 border-gray-100 dark:border-gray-700 dark:text-gray-300 shadow-sm hover:border-blue-400 transition-all"><span class="w-8 h-8 bg-blue-600 text-white rounded-full flex items-center justify-center mr-4 border-2 border-blue-400">4</span> Business Model et perspectives (8:00 - 10:00)</li>
        </ol>

        <div class="flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-4">
            <a href="#" class="bg-gray-800 dark:bg-gray-700 text-white px-6 py-3 rounded-lg font-bold hover:bg-gray-900 transition flex items-center justify-center border-2 border-gray-900 dark:border-gray-600">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                Télécharger le PDF
            </a>
            <a href="#" class="bg-gray-200 dark:bg-gray-600 text-gray-800 dark:text-white px-6 py-3 rounded-lg font-bold hover:bg-gray-300 transition flex items-center justify-center border-2 border-gray-300 dark:border-gray-500 shadow-sm">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                Télécharger les slides
            </a>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
